NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- ad tracking (optional; nothing loads unless set, and only after the visitor accepts cookies) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (link it to Google Ads to import conversions)
NEXT_PUBLIC_GA_ID=
# Meta (Facebook/Instagram) Pixel ID, e.g. 1234567890123456
NEXT_PUBLIC_META_PIXEL_ID=

# --- phone sign-in via Firebase (optional locally; without these the login uses the API's dev codes) ---
# Firebase console → Project settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
