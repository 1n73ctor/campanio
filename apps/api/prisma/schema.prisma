// Companio data model.
// Local dev uses SQLite so the project runs with zero infra. For production switch
// `provider` to "postgresql" and point DATABASE_URL at Postgres (see docker-compose.yml).
// Enum-like fields are Strings; the allowed values live in @companio/types (enums.ts).
// All money columns are integer rupees.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  phone                  String?                 @unique
  // admin sign-in email (unique). Members' email lives in contactEmail so typing one can't collide with, or reveal, an admin login.
  email                  String?                 @unique
  contactEmail           String?
  // set when they click the link we emailed to contactEmail; cleared when the address changes. Only verified addresses get our emails.
  contactEmailVerifiedAt DateTime?
  /// the admin who added this account by hand (Admin → Users → Add user); null = they signed up themselves
  createdByAdminId       String?
  passwordHash           String?
  name                   String?
  dob                    DateTime?
  gender                 String?
  city                   String?
  bio                    String?
  avatarUrl              String?
  /// the profile picture is the host's first photo (they never uploaded their own): it follows the photo order
  avatarAuto             Boolean                 @default(false)
  role                   String                  @default("USER")
  status                 String                  @default("ACTIVE")
  statusReason           String?
  onboarded              Boolean                 @default(false)
  guidelinesAccepted     DateTime?
  warnings               Int                     @default(0)
  // referrals: code is generated lazily; reward is paid once, when the referred user's first booking is released
  referralCode           String?                 @unique
  referredById           String?
  referredBy             User?                   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]                  @relation("Referrals")
  referralRewardedAt     DateTime?
  // companion registration fee (amount incl. GST); a refund reopens the fee, so re-applying means paying again
  companionFeePaid       Int?
  companionFeePaidAt     DateTime?
  companionFeeRefundedAt DateTime?
  // one-time welcome credit (set when it's paid so it can never be paid twice)
  welcomeCreditAt        DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  // on deletion the phone moves here: frees the number for a new sign-up, but admins still see who it was
  deletedPhone           String?
  // bumped by "log out of all other devices": tokens carrying an older version stop working
  tokenVersion           Int                     @default(0)
  // admin sign-in protection: lock after repeated wrong passwords; optional authenticator-app 2FA
  failedLogins           Int                     @default(0)
  lockedUntil            DateTime?
  totpSecret             String?
  totpEnabledAt          DateTime?
  totpLastStep           Int?
  chatsAsUser            Conversation[]          @relation("ConversationUser")
  topUpRequests          TopUpRequest[]          @relation("TopUpRequests")
  assistantChats         AssistantConversation[] @relation("AssistantConversations")
  chatsAsHost            Conversation[]          @relation("ConversationHost")
  directMessages         DirectMessage[]         @relation("DirectMessageSender")

  companion         CompanionProfile?
  wallet            Wallet?
  bookings          Booking[]           @relation("BookingUser")
  companionBookings Booking[]           @relation("BookingCompanion")
  messages          Message[]
  reviewsWritten    Review[]            @relation("ReviewAuthor")
  reviewsReceived   Review[]            @relation("ReviewTarget")
  reportsMade       Report[]            @relation("ReportReporter")
  reportsAgainst    Report[]            @relation("ReportTarget")
  blocks            Block[]             @relation("Blocker")
  blockedBy         Block[]             @relation("Blocked")
  kycSubmissions    KycSubmission[]
  digilocker        DigilockerSession[]
  payouts           Payout[]
  notifications     Notification[]
  sosAlerts         SosAlert[]
  disputes          Dispute[]
  payments          Payment[]
  auditLogs         AuditLog[]
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  /// how it was sent: "whatsapp" or "sms"
  channel     String?
  /// WhatsApp: Meta's message id and its latest delivery status (sent / delivered / read / failed), from the webhook
  waMessageId String?
  waStatus    String?
  waError     String?

  @@index([phone, createdAt])
  @@index([waMessageId])
}

model CompanionProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline          String
  about             String
  hourlyRate        Int
  /// comma-separated category slugs
  categories        String
  /// comma-separated languages
  languages         String
  city              String
  /// JSON array of photo URLs
  photos            String   @default("[]")
  /// JSON weekly availability { mon: [{from,to}], ... }
  availability      String   @default("{}")
  kycStatus         String   @default("NOT_SUBMITTED")
  isListed          Boolean  @default(false)
  // women companions can accept bookings from women only
  womenOnly         Boolean  @default(false)
  /// ⭐ Premium host (set by an admin): photos and bio stay blurred until a member unlocks them
  premium           Boolean  @default(false)
  premiumSince      DateTime?
  /// turned off by an admin ("Normal user"): hidden, can't be booked or messaged, can't go live again themselves
  hostOff           Boolean  @default(false)
  hostOffAt         DateTime?
  ratingAvg         Float    @default(0)
  ratingCount       Int      @default(0)
  completedBookings Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([city])
  @@index([isListed, city])
}

model KycSubmission {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  idType         String
  idLast4        String
  /// full name exactly as on the ID, typed by the applicant (their profile name can be a short name) — admins only
  legalName      String?
  // MANUAL: the companion uploaded a photo of their ID. DIGILOCKER: idDocPath is the photo on their Aadhaar record.
  method         String    @default("MANUAL")
  idDocPath      String
  /// back of the ID (uploads of two-sided IDs: Aadhaar, driving licence, voter ID)
  idDocBackPath  String?
  selfiePath     String
  status         String    @default("PENDING")
  reviewNote     String?
  reviewerId     String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  // from the government record (DigiLocker only) — never the full Aadhaar number
  verifiedName   String?
  verifiedDob    DateTime?
  verifiedGender String?
  // automatic face checks: liveness (a real person, not a photo of one) and selfie ↔ ID photo similarity, scores 0–1
  livenessScore  Float?
  livenessPassed Boolean?
  faceMatchScore Float?
  faceMatched    Boolean?
  /// JSON array of warnings for the reviewer (see KYC_FLAGS)
  flags          String    @default("[]")
  autoApproved   Boolean   @default(false)
  // keyed hash of name + DOB + Aadhaar last 4 digits: the same person behind several accounts has the same hash
  identityHash   String?

  @@index([status])
  @@index([identityHash])
}

/// One DigiLocker consent journey. VERIFIED holds the Aadhaar details until a KYC submission uses them.
model DigilockerSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationId String    @unique
  status         String    @default("PENDING") // PENDING | VERIFIED | FAILED | USED
  name           String?
  dob            DateTime?
  // some older Aadhaar records only carry the year of birth
  birthYear      Int?
  gender         String? // as on Aadhaar: M | F | T
  last4          String?
  photoPath      String?
  failReason     String?
  createdAt      DateTime  @default(now())
  verifiedAt     DateTime?

  @@index([userId, createdAt])
}

model Booking {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("BookingUser", fields: [userId], references: [id])
  companionUserId String
  companion       User      @relation("BookingCompanion", fields: [companionUserId], references: [id])
  category        String
  startAt         DateTime
  endAt           DateTime
  hours           Int
  meetingPoint    String
  note            String?
  status          String    @default("PENDING_PAYMENT")
  hourlyRate      Int
  subtotal        Int
  connectionFee   Int
  gst             Int
  total           Int
  commission      Int
  companionPayout Int
  startCode       String
  cancelReason    String?
  cancelledBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  paidAt          DateTime?
  acceptedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  // meetup reminders already sent (the day before, and ~2h before)
  remindedDayAt   DateTime?
  remindedSoonAt  DateTime?

  escrow       Escrow?
  payments     Payment[]
  messages     Message[]
  review       Review?
  dispute      Dispute?
  sosAlerts    SosAlert[]
  locations    LiveLocation[]
  safetyShares SafetyShare[]
  topUps       TopUpRequest[]
  reports      Report[]

  @@index([userId, status])
  @@index([companionUserId, status])
  @@index([status, startAt])
}

model Payment {
  id                String   @id @default(cuid())
  // BOOKING (bookingId set) or COMPANION_FEE (registration fee to become a companion)
  purpose           String   @default("BOOKING")
  bookingId         String?
  booking           Booking? @relation(fields: [bookingId], references: [id])
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  provider          String
  providerOrderId   String   @unique
  providerPaymentId String?
  amount            Int
  walletAmount      Int      @default(0)
  /// how much of walletAmount was spend-only credit — a refund gives that part back as credit, never as cash
  walletPromo       Int      @default(0)
  /// WALLET_TOPUP: extra coins from an offer, worked out when the payment started (added on top once it's paid)
  bonus             Int      @default(0)
  offerId           String?
  offerTitle        String?
  /// the offer was "first top-up only" — re-checked when the payment completes
  offerFirstOnly    Boolean  @default(false)
  /// PREMIUM: what's being unlocked, as JSON { kind, hostUserId? }
  meta              String?
  status            String   @default("CREATED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Escrow {
  id        String    @id @default(cuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id])
  amount    Int
  refunded  Int       @default(0)
  released  Int       @default(0)
  /// platform revenue retained (connection fee + GST + commission)
  retained  Int       @default(0)
  status    String    @default("HELD")
  heldAt    DateTime  @default(now())
  settledAt DateTime?
}

model Wallet {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int         @default(0)
  /// the part of `balance` that is spend-only credit: pays for bookings, can never be withdrawn (see WalletLedger)
  promoBalance Int         @default(0)
  /// the part of `promoBalance` that is coins bought with real money (only these can unlock Premium hosts)
  paidCoins    Int         @default(0)
  updatedAt    DateTime    @updatedAt
  txns         WalletTxn[]
}

model WalletTxn {
  id           String   @id @default(cuid())
  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         String
  amount       Int
  reason       String
  refType      String?
  refId        String?
  /// how much of `amount` was spend-only credit
  promoAmount  Int      @default(0)
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([walletId, createdAt])
}

model Payout {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amount      Int
  upiId       String
  status      String    @default("REQUESTED")
  reference   String?
  note        String?
  processedBy String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int
  comment   String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([targetId])
}

model Message {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  body       String
  flagged    Boolean  @default(false)
  flagReason String?
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  reports Report[]

  @@index([bookingId, createdAt])
  @@index([flagged])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  reporter     User      @relation("ReportReporter", fields: [reporterId], references: [id])
  targetUserId String
  target       User      @relation("ReportTarget", fields: [targetUserId], references: [id])
  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id])
  messageId    String?
  message      Message?  @relation(fields: [messageId], references: [id])
  reason       String
  details      String?
  status       String    @default("OPEN")
  action       String?
  resolution   String?
  handledById  String?
  createdAt    DateTime  @default(now())
  handledAt    DateTime?

  @@index([status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Dispute {
  id             String    @id @default(cuid())
  bookingId      String    @unique
  booking        Booking   @relation(fields: [bookingId], references: [id])
  raisedById     String
  raisedBy       User      @relation(fields: [raisedById], references: [id])
  reason         String
  details        String?
  /// booking status before the dispute froze it
  previousStatus String
  status         String    @default("OPEN")
  outcome        String?
  refundAmount   Int?
  resolutionNote String?
  resolvedById   String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
}

model SosAlert {
  id         String    @id @default(cuid())
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  lat        Float?
  lng        Float?
  status     String    @default("ACTIVE")
  note       String?
  // USER (in-app SOS) or TRUSTED_CONTACT (raised from a shared safety link; userId = the person who shared it)
  source     String    @default("USER")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
}

/// "Watch my session": a private, expiring link a booking participant sends to someone they trust.
model SafetyShare {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([bookingId, userId])
}

model LiveLocation {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt

  @@unique([bookingId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  meta       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

/// A paid chat between a member and a host (outside any meetup). The member opens it with coins (wallet balance).
model Conversation {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("ConversationUser", fields: [userId], references: [id])
  hostId        String
  host          User      @relation("ConversationHost", fields: [hostId], references: [id])
  /// opened for good (a permanent unlock that wasn't refunded)
  permanent     Boolean   @default(false)
  /// a timed unlock lets the member write until then
  accessUntil   DateTime?
  lastMessageAt DateTime?
  hostRepliedAt DateTime?
  userReadAt    DateTime?
  hostReadAt    DateTime?
  createdAt     DateTime  @default(now())

  messages DirectMessage[]
  unlocks  ChatUnlock[]

  @@unique([userId, hostId])
  @@index([hostId, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("DirectMessageSender", fields: [senderId], references: [id])
  body           String
  flagged        Boolean      @default(false)
  flagReason     String?
  hidden         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Every coin payment to open a chat — the log admins see. All of it is platform revenue unless refunded.
model ChatUnlock {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  hostId         String
  /// TIMED or PERMANENT
  kind           String
  price          Int
  /// TIMED: how long it opened the chat for
  hours          Int?
  /// how much of the price was spend-only credit (refunded as credit)
  promoUsed      Int          @default(0)
  /// the host's share (%) when this was paid, and what they got once they replied (withdrawable)
  hostSharePct   Int          @default(0)
  hostEarning    Int          @default(0)
  /// ACTIVE (waiting for the host's reply) · ANSWERED (host replied — kept) · REFUNDED (no reply in time)
  status         String       @default("ACTIVE")
  refundDueAt    DateTime
  refundedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, refundDueAt])
  @@index([createdAt])
}

/// Old coin top-ups paid by UPI QR and approved by an admin (replaced by Razorpay). Kept only as a record of past
/// payments; nothing creates new ones.
model TopUpRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("TopUpRequests", fields: [userId], references: [id])
  amount       Int
  /// short code the member puts in the UPI payment note (e.g. CMP-7KQ2)
  ref          String    @unique
  note         String
  /// UPI transaction ID (UTR), if the member entered it
  utr          String?
  /// topping up to pay this meetup: once approved, it's paid from the wallet automatically
  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  /// STARTED (QR shown) · PENDING (member says they paid) · APPROVED · REJECTED · CANCELLED
  status       String    @default("STARTED")
  credited     Int?
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  submittedAt  DateTime?
  reviewedAt   DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([utr])
}

/// A conversation with the AI support assistant (signed in or anonymous). `key` is the secret the browser keeps to
/// continue it; signed-in conversations also belong to the user.
model AssistantConversation {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String?
  user      User?    @relation("AssistantConversations", fields: [userId], references: [id], onDelete: SetNull)
  /// sha256 of the visitor's IP — rate limits for signed-out visitors, never the IP itself
  ipHash    String?
  /// asked for (or was passed to) a human
  handoff   Boolean  @default(false)
  /// talking to the team instead of the AI: null = with the AI · "waiting" = their last message is unanswered ·
  /// "answered" = the team replied last · "closed" = the team ended it (the AI answers again)
  humanStatus String?
  /// left by the visitor when no one from the team was free — the team's replies are emailed here too
  contactEmail String?
  summary   String?
  /// 1 = 👍, -1 = 👎 from the user
  rating    Int?
  createdAt DateTime @default(now())
  lastAt    DateTime @default(now())

  messages AssistantMessage[]

  @@index([lastAt])
  @@index([userId, lastAt])
  @@index([ipHash, lastAt])
  @@index([humanStatus, lastAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant | agent (someone from the team) | note (a status line, e.g. "the team ended this chat")
  role           String
  /// agent messages: the team member's first name, shown to the user
  authorName     String?
  content        String
  /// assistant replies: "ai" (the model answered) or "instant" (a free built-in / approved answer, no AI call)
  source         String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

/// Answers an admin has approved for the assistant to use (the way it "learns" from past chats).
model AssistantKnowledge {
  id        String   @id @default(cuid())
  question  String
  answer    String
  active    Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bonus coins on wallet top-ups, set by an admin (Admin → Coin purchases → Offers). The best offer that applies is
/// given; extra coins are spend-only, like all coins.
model TopUpOffer {
  id        String    @id @default(cuid())
  /// shown to members, e.g. "Diwali bonus"
  title     String
  /// applies to top-ups of at least this many rupees
  minAmount Int
  /// extra coins as a % of the amount paid
  bonusPct  Int
  /// most extra coins one top-up can get (null = no cap)
  maxBonus  Int?
  /// only a member's first ever top-up
  firstOnly Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A member unlocking Premium hosts: one host (HOST), all of them for 30 days (PASS_30) or for good (LIFETIME).
/// Paid only with real money — through the gateway or with coins they bought. All of it is platform revenue.
model PremiumUnlock {
  id           String    @id @default(cuid())
  userId       String
  kind         String
  /// HOST unlocks: the host's user id
  hostUserId   String?
  price        Int
  /// GATEWAY or COINS
  paidWith     String
  paymentId    String?
  /// PASS_30: when it runs out (null = never)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([hostUserId])
}
