{
  "name": "@companio/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma db push || (echo \"\n⚠️  The database was NOT updated (see above) — starting the API anyway. Switching branches? Run: npm run db:push -w @companio/api\n\" && prisma generate); nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:create-admin": "tsx prisma/create-admin.ts",
    "kyc:encrypt": "tsx prisma/encrypt-kyc-docs.ts",
    "db:reset-activity": "tsx prisma/reset-activity.ts",
    "mail:test": "tsx prisma/send-test-email.ts",
    "db:verify-existing-emails": "tsx prisma/verify-existing-emails.ts",
    "db:rewrite-file-urls": "tsx prisma/rewrite-file-urls.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@companio/types": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "~6.5.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "~0.14.2",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "prisma": "~6.19.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
