# --- core ---
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
# comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000"
# public base URL of this API (used to build upload URLs)
PUBLIC_API_URL="http://localhost:4000"
# base URL of the website (used in notification links)
WEB_URL="http://localhost:3000"
# where photo / ID-document links point (empty = PUBLIC_API_URL)
FILES_BASE_URL=

# --- OTP ---
# Firebase phone sign-in (production): the project ID from Firebase console. Leave empty locally to use the dev codes below.
FIREBASE_PROJECT_ID=
# In local dev the OTP is logged and echoed back in the API response. NEVER enable in production.
OTP_DEV_ECHO=true
# SMS provider hook: "console" (logs) — plug MSG91/Twilio in src/auth/sms.service.ts
SMS_PROVIDER=console

# --- payments ---
# "mock" (default, fake checkout) or "razorpay"
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- companion ID verification (Cashfree Secure ID: DigiLocker + face liveness + face match) ---
# CASHFREE_VRS_ENV:
#   demo       — pretend DigiLocker + face check served by this API; try the flow with no Cashfree account (local only)
#   sandbox    — Cashfree test keys; test identities, every face check passes. Cashfree only sends people back to an
#                https:// address, so the DigiLocker step may not work on http://localhost — test it on your https site
#   production — real checks (production keys)
# Leave the keys empty (and not demo) for manual ID upload only.
CASHFREE_VRS_ENV=demo
CASHFREE_VRS_CLIENT_ID=
CASHFREE_VRS_CLIENT_SECRET=
FACE_MATCH_THRESHOLD=0.75

# --- email (welcome email on sign-up). Hostinger mailbox: smtp.hostinger.com, port 465 ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@getcompanio.in
# the mailbox password (Hostinger → Emails → info@getcompanio.in); leave empty to switch email off
SMTP_PASS=

# --- seeded admin ---
ADMIN_EMAIL=admin@companio.local
ADMIN_PASSWORD=admin12345

# --- login codes on WhatsApp (Meta WhatsApp Cloud API) ---
# WhatsApp first, SMS (Firebase) for numbers without WhatsApp. Empty token or phone number ID = SMS only.
# Token: a permanent System User token with whatsapp_business_messaging (Business settings → System users).
WHATSAPP_TOKEN=
# Meta app → WhatsApp → API Setup → "Phone number ID" (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# the approved Authentication template (copy-code button) and its language
WHATSAPP_OTP_TEMPLATE=companio_login_otp
WHATSAPP_OTP_LANGUAGE=en
# webhook (delivery receipts → switch to SMS when a number isn't on WhatsApp):
#   callback URL https://<api domain>/whatsapp/webhook, subscribe to "messages"
# Meta app → Settings → Basic → App secret
WHATSAPP_APP_SECRET=
# any long random string; paste the same value as "Verify token" in Meta
WHATSAPP_VERIFY_TOKEN=

# --- coins by UPI QR (until the payment gateway is live) ---
# the UPI ID and name members pay; an admin approves each payment in Admin → Coin top-ups. Empty = off.
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=

# --- AI support assistant (Riya) ---
# console.anthropic.com → API keys. Empty = assistant off. "mock" = fixed answers for tests (no AI calls).
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-4-5-20251001
