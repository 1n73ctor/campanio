# Template for apps/api/.env on the server. setup-server.sh copies it and fills in the __PLACEHOLDERS__ it can;
# edit the rest by hand. Never commit the real file.

PORT=4000
DATABASE_URL="file:/srv/companio-data/companio.db"
UPLOAD_DIR=/srv/companio-data/uploads
JWT_SECRET=__JWT_SECRET__

# Your website URL(s), comma-separated, no trailing slash. The admin panel is served at <website>/admin, so it's covered too.
CORS_ORIGINS="https://yourdomain.com"
# This API's public URL (used to build upload links)
PUBLIC_API_URL="https://__API_DOMAIN__"
# The website's URL (used in notification links)
WEB_URL="https://yourdomain.com"

# --- login codes ---
# Firebase sends and checks the SMS code; the API only verifies Firebase's signed token.
# Use the Project ID from Firebase console → Project settings (must match the website's NEXT_PUBLIC_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=
OTP_DEV_ECHO=false
# Only used if you send SMS yourself instead of Firebase (MSG91 / Gupshup / Twilio in apps/api/src/auth/sms.service.ts)
SMS_PROVIDER=console

# --- payments ---
# The API refuses to start with "mock" in production (set ALLOW_MOCK_PAYMENTS=true only on a private test server).
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- admin account (created by: npm run db:create-admin -w @companio/api) ---
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=
