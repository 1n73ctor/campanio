# Template for apps/api/.env on the server. setup-server.sh copies it and fills in the __PLACEHOLDERS__ it can;
# edit the rest by hand. Never commit the real file.

PORT=4000
DATABASE_URL="file:/srv/companio-data/companio.db"
UPLOAD_DIR=/srv/companio-data/uploads
JWT_SECRET=__JWT_SECRET__
# Encrypts ID documents on disk. Keep a copy in a password manager: without it, backed-up documents can't be read.
KYC_ENCRYPTION_KEY=__KYC_KEY__

# Your website URL(s), comma-separated, no trailing slash. The admin panel is served at <website>/admin, so it's covered too.
CORS_ORIGINS="https://yourdomain.com"
# This API's public URL (used to build upload links)
PUBLIC_API_URL="https://__API_DOMAIN__"
# The website's URL (used in notification links)
WEB_URL="https://yourdomain.com"

# --- login codes ---
# Firebase sends and checks the SMS code; the API only verifies Firebase's signed token.
# Use the Project ID from Firebase console → Project settings (must match the website's NEXT_PUBLIC_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=
OTP_DEV_ECHO=false
# Only used if you send SMS yourself instead of Firebase (MSG91 / Gupshup / Twilio in apps/api/src/auth/sms.service.ts)
SMS_PROVIDER=console

# --- payments ---
# The API refuses to start with "mock" in production (set ALLOW_MOCK_PAYMENTS=true only on a private test server).
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- companion ID verification: DigiLocker (Aadhaar) + selfie liveness + face match, via Cashfree Secure ID ---
# Leave the keys empty to keep manual ID uploads only. Use the *Secure ID* keys (merchant.cashfree.com → Secure ID →
# Developers → API Keys), not payment keys, and whitelist this server's IP there (Developers → Two-Factor Authentication).
# DigiLocker needs a one-time activation request to Cashfree support.
# Testing before you have production keys: CASHFREE_VRS_ENV=sandbox + sandbox keys + ALLOW_SANDBOX_KYC=true. The sandbox
# "verifies" made-up identities, so the admin panel marks it as test mode and auto-approve stays off — switch to
# production before real companions sign up.
CASHFREE_VRS_ENV=production
CASHFREE_VRS_CLIENT_ID=
CASHFREE_VRS_CLIENT_SECRET=
# selfie ↔ Aadhaar photo similarity needed to count as a match (Cashfree recommends 0.75)
FACE_MATCH_THRESHOLD=0.75

# --- admin account (created by: npm run db:create-admin -w @companio/api) ---
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=
